# Optional. Copy this file to brief.env and put your own key after the = sign.
# With a key, "The day in 60 seconds" is written by AI from the headlines. Without it, the app still works.
# Never share this file or paste the key in a chat.
ANTHROPIC_API_KEY=
# Optional: free key from fred.stlouisfed.org for the "Coming up" release calendar
FRED_API_KEY=
# Optional: instant alerts for high-impact stories (impact 8+/10 or a watch word with a clear bullish/bearish tone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
