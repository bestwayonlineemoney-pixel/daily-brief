# Optional. Copy this file to brief.env and put your own key after the = sign.
# With an AI key, "The day in 60 seconds", the tone of each story and the trader's brief are written by AI. Without one, the app still works.
# Use either a Google Gemini key (aistudio.google.com) or a Claude key. Gemini is used first when both are set.
# Never share this file or paste a key in a chat.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: free key from fred.stlouisfed.org for the "Coming up" release calendar
FRED_API_KEY=
# Optional: instant alerts for high-impact stories (impact 8+/10 or a watch word with a clear bullish/bearish tone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
